# Environment Variables Template
# Copy this to .env.local and fill in actual values

# Required: PostgreSQL database connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/scope_editorial

# Required: Secret key for session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=your-very-secure-session-secret-here-change-in-production

# Optional: OpenAI API key for text-to-speech audio generation
# Get from: https://platform.openai.com/account/api-keys
# Leave blank to disable audio generation
OPENAI_API_KEY=sk-proj-xxxxx

# Optional: Cloudinary URL for image storage
# Format: cloudinary://api_key:api_secret@cloud_name
# Get from: https://cloudinary.com/console/settings/api
# Leave blank to disable image uploads (existing images with URLs still work)
CLOUDINARY_URL=cloudinary://key:secret@cloud

# Optional: Node environment
NODE_ENV=development

# Optional: Server port (default: 10000 for Render compatibility)
PORT=10000
